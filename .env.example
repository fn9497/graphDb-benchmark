# Copy this file to .env and fill in your real credentials.
# NEVER commit the real .env file.

# ---- CognoDB Cloud ----
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<paste-once-shown-password>

# ---- Neo4j AuraDB Free ----
AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
AURA_USER=neo4j
AURA_PASSWORD=<your-aura-password>

# Benchmark tuning (safe defaults for a 2-hour scope-reduced run)
BENCH_ITERATIONS=20
BENCH_CONCURRENCY=10
